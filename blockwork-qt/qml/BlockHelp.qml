    // The block's own title, or its wire name spelled out ("WaitUntil" -> "Wait until").
    function title(type) {
        const titles = {
            Add: qsTr("Add"),
            Sub: qsTr("Subtract"),
            Mul: qsTr("Multiply"),
            Div: qsTr("Divide"),
            Mod: qsTr("Modulo"),
            Eq: qsTr("Equals"),
            Neq: qsTr("Not equal"),
            Gt: qsTr("Greater than"),
            Lt: qsTr("Less than"),
            Gte: qsTr("At least"),
            Lte: qsTr("At most"),
            Join3: qsTr("Join three"),
            Var: qsTr("Variable"),
            Param: qsTr("Block input"),
            Call: qsTr("Custom reporter"),
            CallBlock: qsTr("Custom block"),
            BlockHeader: qsTr("Custom block definition"),
            ListAsJson: qsTr("List as JSON"),
            JsonGet: qsTr("JSON get"),
            HttpGet: qsTr("HTTP get"),
            HttpRequest: qsTr("HTTP request"),
            Text: qsTr("Type text")
        };
        if (titles[type]) return titles[type];
        const h = String(type).replace(/([a-z0-9])([A-Z])/g, "$1 $2").toLowerCase();
        return h.charAt(0).toUpperCase() + h.slice(1);
    }
