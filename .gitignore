# Local blockstitch override written by `just blockstitch-local`
.cargo/config.toml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Inno Setup installer output
dist/

# Flatpak build output (staged CEF runtime payload + build state)
packaging/flatpak/blockwork
packaging/flatpak/libcef.so
packaging/flatpak/libEGL.so
packaging/flatpak/libGLESv2.so
packaging/flatpak/libvk_swiftshader.so
packaging/flatpak/libvulkan.so.1
packaging/flatpak/vk_swiftshader_icd.json
packaging/flatpak/chrome-sandbox
packaging/flatpak/icudtl.dat
packaging/flatpak/v8_context_snapshot.bin
packaging/flatpak/chrome_100_percent.pak
packaging/flatpak/chrome_200_percent.pak
packaging/flatpak/resources.pak
packaging/flatpak/locales/
packaging/flatpak/.flatpak-builder/
packaging/flatpak/*.local.yml
flatpak-build/
flatpak-repo/

# AppImage build output
AppDir/
*.AppImage

# Flatpak bundle output
*.flatpak

# macOS app bundle output
*.app.zip

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/