# Maintainer: Ethan Stokes <erstokes10@gmail.com>
# Rendered from packaging/aur/blockwork-bin/PKGBUILD.in in Blockworked/Blockwork by .github/workflows/aur.yml.

pkgname=blockwork-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Build keyboard and mouse macros by snapping blocks together (prebuilt for Arch)'
url='https://blockworked.com'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'hicolor-icon-theme' 'gcc-libs' 'glibc' 'dbus' 'libxkbcommon' 'wayland' 'gtk3')
optdepends=('qt6-wayland: native Wayland window'
            'tesseract: text recognition blocks'
            'grim: screen blocks on wlroots desktops'
            'kdotool: window blocks on KDE Plasma')
provides=("blockwork=$pkgver" 'macros')
conflicts=('blockwork' 'blockwork-git' 'macros')
options=('!strip' '!debug')
_release=https://github.com/Blockworked/Blockwork/releases/download/@TAG@
source_x86_64=("blockwork-$pkgver-x86_64.pkg.tar.zst::$_release/blockwork-arch-x86_64.pkg.tar.zst")
source_aarch64=("blockwork-$pkgver-aarch64.pkg.tar.zst::$_release/blockwork-arch-aarch64.pkg.tar.zst")
noextract=("blockwork-$pkgver-x86_64.pkg.tar.zst" "blockwork-$pkgver-aarch64.pkg.tar.zst")
sha256sums_x86_64=('@X86_64_SHA256@')
sha256sums_aarch64=('@AARCH64_SHA256@')

package() {
    bsdtar -xf "$srcdir/blockwork-$pkgver-$CARCH.pkg.tar.zst" -C "$pkgdir" usr/
    mv "$pkgdir/usr/share/licenses/blockwork" "$pkgdir/usr/share/licenses/$pkgname"
}
